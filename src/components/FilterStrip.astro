---
import { CATEGORY_ORDER, CATEGORY_LABELS, products } from '../lib/products.js';

const counts = Object.fromEntries(CATEGORY_ORDER.map((c) => [c, 0]));
for (const p of products) for (const c of p.categories) if (c in counts) counts[c]++;
const total = products.length;
---
<div class="strip" role="region" aria-label="Filter catalogue">
  <div class="wrap">
    <span class="readout" data-readout>{total} items</span>
    <button class="chip" data-filter="all" aria-pressed="true">All</button>
    {CATEGORY_ORDER.map((c) => (
      <button class="chip" data-filter={c} aria-pressed="false">
        {CATEGORY_LABELS[c]} <span aria-hidden="true">· {counts[c]}</span>
      </button>
    ))}
    <span class="search">
      <input type="search" placeholder="Search" aria-label="Search products" data-search-input autocomplete="off" />
    </span>
  </div>
</div>

<script>
  const strip = document.querySelector('.strip');
  const chips = [...strip.querySelectorAll('.chip')];
  const input = strip.querySelector('[data-search-input]');
  const readout = strip.querySelector('[data-readout]');
  const cards = [...document.querySelectorAll('main .card')];
  let filter = 'all';

  function apply() {
    const q = (input.value || '').trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const okCat = filter === 'all' || (card.dataset.cats || '').split(' ').includes(filter);
      const okQ = !q || (card.dataset.search || '').includes(q);
      const show = okCat && okQ;
      card.hidden = !show;
      if (show) shown++;
    }
    readout.textContent = `${shown} item${shown === 1 ? '' : 's'}`;
  }

  chips.forEach((chip) => chip.addEventListener('click', () => {
    filter = chip.dataset.filter;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    apply();
  }));
  input.addEventListener('input', apply);
</script>

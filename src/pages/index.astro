---
import Base from '../layouts/Base.astro';
import FilterStrip from '../components/FilterStrip.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, sortedByDate } from '../lib/products.js';
import { SITE } from '../lib/site.js';

const list = sortedByDate(products);
const skadisCount = products.filter((p) => p.categories.includes('skadis')).length;
const lampCount = products.filter((p) => p.categories.includes('lamps')).length;

// Cursor trail (see mirko-404 spec). Ten boxes, each a random product shot.
// Box 1 rides the live pointer; every box after it replays where the pointer
// was 0.5s earlier than the one before, so they string out along the path.
const pool = list
  .map((p) => (p.images.colour || p.images.plain || '').replace(/\.[^.]+$/, ''))
  .filter(Boolean)
  .map((stem) => `/img/${stem}-600.webp`);
const pick = (n) => {
  const bag = [...pool];
  return Array.from({ length: Math.min(n, bag.length) }, () =>
    bag.splice(Math.floor(Math.random() * bag.length), 1)[0]);
};
// art-directed flat-lay: upper-right cascading to lower-left, slight rotations
// Offsets are percentages of a box's own size, so the flat-lay scales with it.
const scatter = [
  { x: 196, y: -30, r: -8 },
  { x: 152, y: 26, r: 4 },
  { x: 112, y: -22, r: 7 },
  { x: 64, y: 30, r: -5 },
  { x: 22, y: -32, r: 3 },
  { x: -26, y: 22, r: 9 },
  { x: -70, y: -26, r: -4 },
  { x: -118, y: 30, r: 6 },
  { x: -158, y: -18, r: -7 },
  { x: -202, y: 24, r: 5 },
];
const stackImages = pick(scatter.length);

const title = `Jer{folio} — ${products.length} 3D-printable lamps, IKEA SKÅDIS mods & organisers`;
const description = `All ${products.length} downloadable 3D-print designs by Jerry Ho: ${skadisCount} IKEA SKÅDIS pegboard accessories, ${lampCount} desk lamps, Apple charging stands and organisers. Filter, search, then head to a store.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE}/#website`,
    name: 'Jer{folio}',
    url: `${SITE}/`,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE}/about#jerry`,
    name: 'Jerry Ho',
    url: `${SITE}/about`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    '@id': `${SITE}/#itemlist`,
    name: 'Jer{folio} 3D Print Catalogue',
    numberOfItems: list.length,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: list.map((p, i) => ({
      '@type': 'ListItem', position: i + 1, url: `${SITE}/product/${p.slug}`, name: p.name,
    })),
  },
];
---
<Base {title} {description} activeNav="catalog" path="/" {jsonLd} feed={true}>
  <section class="hero" data-cursor-stack>
    <div class="stack" aria-hidden="true">
      {stackImages.map((src, i) => (
        <div class="img-box" style={`--sx:${scatter[i].x}%;--sy:${scatter[i].y}%;--sr:${scatter[i].r}deg;--fx:${i * 7}%;--fy:${(i % 2 ? 1 : -1) * i * 2.4}%;z-index:${scatter.length - i}`}>
          <img src={src} alt="" width="300" height="300" loading="eager" decoding="async" />
        </div>
      ))}
    </div>
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <h1 class="big"><span>3D print</span><span class="out">catalogue</span></h1>
          <p class="tag">Lamps, IKEA SKÅDIS pegboard accessories, Apple charging stands and
            desk organisers. Designed in Hong Kong, printed on your machine.</p>
          <div class="stats">
            <div><span class="n">{products.length}</span><span class="lbl">Designs</span></div>
            <div><span class="n">{skadisCount}</span><span class="lbl">SKÅDIS</span></div>
            <div><span class="n">{lampCount}</span><span class="lbl">Lamps</span></div>
            <div><span class="n">5</span><span class="lbl">Stores</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FilterStrip />

  <main id="main">
    <div class="wrap">
      <div class="grid">
        {list.map((p) => <ProductCard {p} medium="card" />)}
      </div>
    </div>
  </main>
</Base>

---
import Base from '../layouts/Base.astro';
import { products } from '../lib/products.js';
import { SITE } from '../lib/site.js';

const skadisCount = products.filter((p) => p.categories.includes('skadis')).length;

// Skill / tool icons for the floating marquee. Drop the real logos (SVG, ~1:1,
// transparent or white ground) at public/about-icons/<file>; placeholders show
// until then. Order is the visual order in the loop.
const skillIcons = [
  { name: 'Figma', file: '01-figma.png' },
  { name: 'Adobe Creative Cloud', file: '02-adobe-cc.png' },
  { name: 'Claude', file: '03-claude.png' },
  { name: 'ChatGPT', file: '04-openai.png' },
  { name: 'Autodesk Fusion', file: '05-fusion360.png' },
  { name: 'Jira', file: '06-atlassian.png' },
  { name: 'Instagram', file: '07-instagram.png' },
  { name: 'Autodesk', file: '08-autodesk.png' },
  { name: 'Buy Me a Coffee', file: '09-buymeacoffee.svg' },
];

const links = {
  instagram: 'https://instagram.com/jer_folio',
  behance: 'https://www.behance.net/', // TODO: real Behance URL
  email: '516.jerry.ho@gmail.com',
};

const title = 'About — Jerry Ho, UI/UX designer & 3D-print maker | Jer{folio}';
const description = `Jerry Ho is a Hong Kong UI/UX designer who also draws and sells ${products.length}+ 3D-printable designs — IKEA SKÅDIS systems, desk lamps and organisers — and documents the process across Instagram, YouTube and TikTok. Open to design commissions, brand collaborations and sponsorships.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${SITE}/about`,
    url: `${SITE}/about`,
    name: 'About Jerry Ho',
    mainEntity: { '@id': `${SITE}/about#jerry` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE}/about#jerry`,
    name: 'Jerry Ho',
    alternateName: 'Jer',
    url: `${SITE}/about`,
    jobTitle: ['UI/UX Designer', '3D Print Designer', 'Content Creator'],
    knowsAbout: ['UI/UX design', '3D printing', 'product design', 'IKEA SKÅDIS', 'content creation'],
    address: { '@type': 'PostalAddress', addressLocality: 'Hong Kong' },
    email: `mailto:${links.email}`,
    sameAs: [
      links.instagram,
      'https://www.threads.net/@jer_folio',
      'https://www.youtube.com/@jer_folio',
      'https://www.tiktok.com/@jerfolio',
      'https://cults3d.com/en/users/JerH/3d-models',
      'https://thangs.com/designer/Jer_Ho',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ '@type': 'ListItem', position: 1, name: 'About', item: `${SITE}/about` }],
  },
];
---
<Base {title} {description} path="/about" activeNav="about" {jsonLd} showStores={false}>
  <main id="main" class="about">
    <section class="about-hero">
      <div class="wrap">
        <div class="stage">
          <!-- 3 pre-aligned same-size layers + the icon marquee, stacked in one box -->
          <div class="about-media" aria-hidden="true">
            <img class="lyr l-back" alt="" width="692" height="669" loading="lazy"
              src="/img/about-props-1000.webp"
              srcset="/img/about-props-460.webp 460w, /img/about-props-700.webp 700w, /img/about-props-1000.webp 1000w"
              sizes="(min-width:900px) 560px, 92vw" />

            <div class="lyr l-icons">
              <ul class="icon-track">
                {[...skillIcons, ...skillIcons].map((ic, i) => (
                  <li class="icon" style={`--i:${i % skillIcons.length}`}>
                    <img src={`/about-icons/${ic.file}`} alt={ic.name}
                      onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'ph',textContent:this.alt}))" />
                  </li>
                ))}
              </ul>
            </div>

            <img class="lyr l-front" alt="" width="692" height="669" fetchpriority="high"
              src="/img/about-portrait-1000.webp"
              srcset="/img/about-portrait-460.webp 460w, /img/about-portrait-700.webp 700w, /img/about-portrait-1000.webp 1000w"
              sizes="(min-width:900px) 560px, 92vw" />
            <img class="lyr l-cursor" alt="" width="692" height="669" loading="lazy"
              src="/img/about-cursor-700.webp"
              srcset="/img/about-cursor-460.webp 460w, /img/about-cursor-700.webp 700w"
              sizes="(min-width:900px) 560px, 92vw" />
          </div>

          <!-- copy -->
          <div class="copy">
            <h1>Jerry Ho</h1>
            <p class="role">UI/UX Designer <b>·</b> Maker <b>·</b> 3D-Print Creator</p>
            <p class="bio">
              UI/UX designer in Hong Kong, applying the same fixation on flow and detail
              to physical objects. <b>Jer{'{'}folio{'}'}</b> is my catalogue of
              {' '}{products.length}+ 3D-printable designs — {skadisCount} IKEA SKÅDIS
              pieces, plus desk lamps, charging docks and organisers.
            </p>
            <p class="bio">
              I also document the process on Instagram, YouTube and TikTok.
              <a href="#collab">Let's talk</a> if you're building something.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="about-do wrap">
      <p class="lbl">What I do</p>
      <div class="do-grid">
        <div>
          <svg class="do-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 9h18"/><path d="m13 14 3 2.5-3 2.5-1-2z" fill="currentColor" stroke="none"/></svg>
          <h3>UI/UX Design</h3>
          <p>Product and interface design — research, flows, prototypes, design
            systems. The day job, and the lens on everything else.</p>
        </div>
        <div>
          <svg class="do-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 3 7.5v9L12 21l9-4.5v-9Z"/><path d="M3 7.5 12 12l9-4.5M12 12v9"/></svg>
          <h3>3D-Print Design</h3>
          <p>{products.length}+ downloadable models, sold on Cults3D, Thangs, Pixup
            and Cubee. The IKEA SKÅDIS ecosystem is the core.</p>
        </div>
        <div>
          <svg class="do-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m10 9 5 3-5 3z" fill="currentColor" stroke="none"/></svg>
          <h3>Content Creation</h3>
          <p>Build logs, design breakdowns and print tips on Instagram, Threads,
            YouTube and TikTok — <b>@jer_folio</b>.</p>
        </div>
        <div>
          <svg class="do-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M3 12h18M5.5 5.5l13 13M18.5 5.5l-13 13"/></svg>
          <h3>+ More</h3>
          <p>Branding, illustration and the occasional physical-product consult.
            If it needs designing, ask.</p>
        </div>
      </div>
    </section>

    <section id="collab" class="collab">
      <div class="wrap">
        <p class="lbl">Work with me</p>
        <h2>Design commissions, brand collaborations &amp; sponsorships</h2>
        <p class="collab-lede">Product and print design, sponsored builds, or UI/UX
          contract work — send a note with what you're making.</p>
        <div class="collab-links">
          <a class="b-cults" href={`mailto:${links.email}`}>Email</a>
          <a class="b-thangs" href={links.instagram} target="_blank" rel="noopener">Instagram</a>
          <a class="b-thangs" href={links.behance} target="_blank" rel="noopener">Behance</a>
        </div>
        <p class="collab-mail">{links.email}</p>
      </div>
    </section>
  </main>
</Base>

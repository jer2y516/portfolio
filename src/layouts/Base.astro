---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Social from '../components/Social.astro';
import StoreBar from '../components/StoreBar.astro';
import { SITE } from '../lib/site.js';

const {
  title,
  description,
  path = Astro.url.pathname,
  robots = 'index,follow',
  ogImage = '/img/og.jpg',
  jsonLd = [],
  activeNav = null,
  showStores = true,
  feed = false,
} = Astro.props;

const canonical = new URL(path.replace(/\.html$/, ''), SITE).toString();
const ogImageAbs = new URL(ogImage, SITE).toString();

const nav = [
  { key: 'catalog', label: 'Catalogue', href: '/' },
  { key: 'skadis', label: 'SKÅDIS', href: '/guides/ikea-skadis' },
  { key: 'about', label: 'About', href: '/about' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/Image/logo.svg" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Jer{folio}" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageAbs} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbs} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Matangi:wght@300..900&display=swap" rel="stylesheet" />

  {jsonLd.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="page" data-feed={feed ? '' : undefined}>
    <header class="mast">
      <div class="wrap">
        <a href="/" aria-label="Jer{folio} home" style="display:flex;align-items:center"><Logo /></a>
        <nav class="lbl">
          {nav.map((n) => (
            <a href={n.href} aria-current={activeNav === n.key ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <Social />
      </div>
    </header>

    <slot />

    {showStores && <StoreBar />}
  </div>

  <footer>
    <div class="wrap lbl">
      Jer{'{'}folio{'}'} — 3D printable parts · Hong Kong
      <Social />
    </div>
  </footer>

  <!-- Cursor trail on the catalogue banner (mirko-404 spec): a scattered
       flat-lay on load; on the first pointer move print 1 takes the live cursor
       and print n replays where it was 0.5s * (n-1) ago, so they string out
       along the path that was actually drawn. Each one arrives on an
       under-damped spring, so it leans past its mark and settles back.
       Touch has no cursor — there the flat-lay keeps its spread and drifts. -->
  <script>
    document.querySelectorAll('[data-cursor-stack]').forEach((section) => {
      const stack = section.querySelector('.stack');
      const boxes = [...section.querySelectorAll('.img-box')];
      if (!boxes.length) return;

      // geometry is measured on .stack, not the section — on small screens the
      // stack is a band at the foot of the hero so the prints clear the copy
      const field = stack || section;
      const bounds = () => {
        const r = field.getBoundingClientRect();
        const b = boxes[0].getBoundingClientRect();
        return { r, padX: b.width * 0.42, padY: b.height * 0.42 };
      };
      const clamp = (n, lo, hi) => (n < lo ? lo : n > hi ? hi : n);
      const hover = matchMedia('(hover: hover)').matches;

      // rest state: the scattered flat-lay. On a wide pointer screen it sits
      // right of centre so it never lands on the headline column before the
      // cursor takes over; touch screens keep it centred and just drift it.
      const r0 = field.getBoundingClientRect();
      let tx = r0.width * (hover && r0.width >= 900 ? 0.68 : 0.5), ty = r0.height / 2;
      // Box 0 rides the live pointer; box n replays where it was n * LAG ago,
      // so the prints string out along the path the cursor actually drew.
      const LAG = 0.5;
      const state = boxes.map((el, i) => ({ el, lag: i * LAG, x: tx, y: ty, vx: 0, vy: 0 }));
      let hist = [];   // {t, x, y}, oldest first — the path being replayed
      const maxLag = state[state.length - 1].lag;

      const sample = (want) => {
        for (let i = hist.length - 1; i > 0; i--) {
          if (hist[i - 1].t > want) continue;
          const a = hist[i - 1], b = hist[i];
          const f = b.t === a.t ? 0 : (want - a.t) / (b.t - a.t);
          return { x: a.x + (b.x - a.x) * f, y: a.y + (b.y - a.y) * f };
        }
        return hist[0] || { x: tx, y: ty };
      };

      const paint = () => {
        for (const s of state) s.el.style.translate = `${s.x.toFixed(1)}px ${s.y.toFixed(1)}px`;
      };
      paint();
      if (stack) stack.classList.add('ready');

      // reduced motion: leave the static flat-lay, no follow
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      let engaged = false;
      const engage = () => {
        if (engaged) return;
        engaged = true;
        section.classList.add('engaged');   // tightens the scatter into a fan
      };

      if (hover) {
        window.addEventListener('pointermove', (e) => {
          const { r, padX, padY } = bounds();
          if (!r.width) return;
          tx = clamp(e.clientX - r.left, padX, r.width - padX);
          ty = clamp(e.clientY - r.top, padY, r.height - padY);
          engage();
        }, { passive: true });
      } else {
        // touch: no cursor to glue to, so the scatter stays put and the whole
        // flat-lay drifts gently. Amplitude is small — the spread already fills
        // the banner, pushing further would just crop the outer prints.
        let t = Math.random() * 1000;
        const wander = () => {
          const { r, padX, padY } = bounds();
          if (r.width) {
            t += 0.01;
            const nx = (Math.sin(t) + Math.sin(t * 0.43) * 0.6) / 1.6;
            const ny = (Math.cos(t * 0.77) + Math.cos(t * 0.31) * 0.6) / 1.6;
            // never drift further than the field can hold the outermost print
            const ax = Math.max(0, Math.min(r.width * 0.16, r.width / 2 - padX));
            const ay = Math.max(0, Math.min(r.height * 0.055, r.height / 2 - padY));
            tx = r.width / 2 + nx * ax;
            ty = r.height / 2 + ny * ay;
          }
          setTimeout(wander, 40);
        };
        wander();
      }

      // Under-damped spring: each print leans past its mark and settles back,
      // which is the anticipation/follow-through that a plain lerp lacks.
      const STIFF = 210, DAMP = 21;
      let last = performance.now();
      (function loop(now) {
        const t = now / 1000;
        let dt = Math.min((now - last) / 1000, 0.05); last = now;

        hist.push({ t, x: tx, y: ty });
        if (hist.length > 900) hist = hist.slice(-Math.ceil(maxLag * 90) - 60);

        // fixed substeps keep the spring stable when a frame is late
        const steps = Math.max(1, Math.ceil(dt / 0.0167));
        const h = dt / steps;
        for (const s of state) {
          const p = sample(t - s.lag);
          for (let n = 0; n < steps; n++) {
            s.vx += ((p.x - s.x) * STIFF - s.vx * DAMP) * h;
            s.vy += ((p.y - s.y) * STIFF - s.vy * DAMP) * h;
            s.x += s.vx * h;
            s.y += s.vy * h;
          }
        }
        paint();
        requestAnimationFrame(loop);
      })(last);
    });
  </script>

  <!-- product cards slide in as they scroll into view, staggered per row -->
  <script>
    (() => {
      const cards = [...document.querySelectorAll('.grid .card')];
      if (!cards.length) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        cards.forEach((c) => c.classList.add('in'));
        return;
      }
      document.documentElement.classList.add('card-anim');
      let batch = [];
      let flush = 0;
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          batch.push(e.target);
        }
        if (!batch.length) return;
        clearTimeout(flush);
        flush = setTimeout(() => {
          batch.sort((a, b) => {
            const ra = a.getBoundingClientRect(), rb = b.getBoundingClientRect();
            return ra.top - rb.top || ra.left - rb.left;
          });
          batch.forEach((el, i) => {
            el.style.setProperty('--d', `${Math.min(i, 8) * 70}ms`);
            el.classList.add('in');
            el.addEventListener('animationend', () => el.classList.add('done'), { once: true });
          });
          batch = [];
        }, 30);
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
      cards.forEach((c) => io.observe(c));
    })();
  </script>

  <script>
    document.querySelectorAll('.shot img').forEach(function (el, i) {
      var p = el.dataset.plain, c = el.dataset.colour;
      var ps = el.dataset.plainSet, cs = el.dataset.colourSet;
      if (!c || c === p) return;
      var show = function (src, set) { el.src = src; if (set) el.srcset = set; };
      var pre = new Image(); pre.srcset = cs || ''; pre.src = c;
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (matchMedia('(hover: none)').matches) {
        if (reduce) return;
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (!e.isIntersecting) return;
            io.unobserve(e.target);
            var on = false;
            setTimeout(function () {
              setInterval(function () {
                el.style.opacity = '0';
                setTimeout(function () { on ? show(p, ps) : show(c, cs); on = !on; el.style.opacity = '1'; }, 130);
              }, 3000 + (i % 3) * 400);
            }, i * 220);
          });
        }, { rootMargin: '200px' });
        io.observe(el);
        return;
      }
      var card = el.closest('.card') || el.closest('.detail');
      if (!card) return;
      var main = card.querySelector('.card-main') || card;
      card.addEventListener('mouseenter', function () { show(c, cs); });
      card.addEventListener('mouseleave', function () { show(p, ps); });
      main.addEventListener('focusin', function () { show(c, cs); });
      main.addEventListener('focusout', function () { show(p, ps); });
    });
  </script>
</body>
</html>
